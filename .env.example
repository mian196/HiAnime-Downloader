# Parallel Anime Downloader Configuration
# Copy this file to .env and modify as needed

# Anime URL (optional - if set, skips the URL prompt)
# Must include ?ep= parameter for the first episode
ANIME_URL=https://hianime.to/watch/bleach-806?ep=13793

# Worker counts (adjust based on your system)
DOWNLOAD_WORKERS=2
EMBED_WORKERS=4

# Output settings
OUTPUT_DIR=output

# Download settings
DOWNLOAD_ALL=true  # Download all episodes (true) or prompt for range (false)
VERBOSE=true       # Show yt-dlp download progress (true) or suppress (false)

# yt-dlp settings
RESOLUTION=720
SUBTITLE_LANG=en
AUDIO_TYPE=sub  # 'sub' for Japanese audio (subbed), 'dub' for English audio (dubbed)

# Timeouts (in seconds)
DOWNLOAD_TIMEOUT=3600
EMBED_TIMEOUT=600

# Rate limiting (delay in seconds between starting new downloads)
# Increase if you get rate limited, decrease for faster downloads
DOWNLOAD_DELAY=2
