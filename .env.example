# HiAnime Downloader Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# ANIME URLS
# =============================================================================

# Single anime URL (optional - if set, skips the URL prompt)
ANIME_URL=https://hianime.to/watch/bleach-806

# Multiple anime URLs (queue mode) - comma-separated
# ANIME_URLS takes priority over ANIME_URL if set
# Each anime will be downloaded completely before moving to the next
# ANIME_URLS=https://hianime.to/watch/anime-1,https://hianime.to/watch/anime-2

# =============================================================================
# WORKER SETTINGS
# =============================================================================

# Number of parallel yt-dlp download processes
DOWNLOAD_WORKERS=2

# Number of parallel FFmpeg subtitle embed processes
EMBED_WORKERS=4

# =============================================================================
# OUTPUT SETTINGS
# =============================================================================

# Output directory for downloaded anime
OUTPUT_DIR=output

# =============================================================================
# DOWNLOAD BEHAVIOR
# =============================================================================

# Download all episodes automatically (true) or prompt for range (false)
DOWNLOAD_ALL=true

# Show yt-dlp download progress (true) or suppress output (false)
VERBOSE=true

# Default season number (0 = prompt user each time)
DEFAULT_SEASON=0

# Filename format for output files:
# 'full'     = Title + Episode Title: "Bleach TYBW The Conflict - S01E02 - Kill The King.mkv"
# 'standard' = Title only:            "Bleach TYBW The Conflict - S01E02.mkv"
# 'short'    = First word only:       "Bleach - S01E02.mkv"
# 'season'   = Season/Episode:        "S01E02.mkv"
# 'episode'  = Episode only:          "E02.mkv"
FILENAME_FORMAT=standard

# =============================================================================
# VIDEO SETTINGS
# =============================================================================

# Video resolution (720, 1080, etc.)
RESOLUTION=720

# Audio type: 'sub' for Japanese audio, 'dub' for English dubbed
AUDIO_TYPE=sub

# Subtitle language code
SUBTITLE_LANG=en

# Skip downloading subtitles entirely
NO_SUBTITLES=false

# =============================================================================
# TIMEOUTS (in seconds)
# =============================================================================

# Maximum time for a single episode download
DOWNLOAD_TIMEOUT=3600

# Maximum time for FFmpeg subtitle embedding
EMBED_TIMEOUT=600

# =============================================================================
# RATE LIMITING
# =============================================================================

# Delay in seconds between starting new downloads
# Increase if you get rate limited, decrease for faster downloads
DOWNLOAD_DELAY=2
