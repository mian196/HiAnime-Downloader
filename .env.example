# Parallel Anime Downloader Configuration
# Copy this file to .env and modify as needed

# Worker counts (adjust based on your system)
DOWNLOAD_WORKERS=6
EMBED_WORKERS=4

# Output settings
OUTPUT_DIR=output

# yt-dlp settings
RESOLUTION=720
SUBTITLE_LANG=en

# Timeouts (in seconds)
DOWNLOAD_TIMEOUT=3600
EMBED_TIMEOUT=600
